
<!DOCTYPE html>
<html lang="ta">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Treasure Hunters</title>
<style>
*{box-sizing:border-box}
body{margin:0;background:#10291d;color:white;font-family:Arial;text-align:center}
h1{color:#ffd76a}
canvas{width:96%;max-width:640px;background:#326b3c;border:4px solid #d7a64b;border-radius:12px;touch-action:none}
p{font-size:17px}
.controls{display:grid;grid-template-columns:65px 65px 65px;gap:9px;justify-content:center;margin:15px}
button{padding:14px;border:0;border-radius:12px;background:#ffc65c;font-size:23px;font-weight:bold}
#msg{color:#ffe17d;font-weight:bold}
</style>
</head>
<body>
<h1>🗺️ TREASURE HUNTERS</h1>
<p>💎 Gems: <span id="score">0</span>/5</p>
<canvas id="game" width="480" height="320"></canvas>
<div class="controls">
<button onclick="move(0,-1)">⬆️</button>
<button onclick="move(-1,0)">⬅️</button>
<button onclick="move(0,1)">⬇️</button>
<button onclick="move(1,0)">➡️</button>
</div>
<p id="msg">5 Gems சேகரித்து புதையலை கண்டுபிடி!</p>
<button onclick="restart()">🔄 Restart</button>
<script>
const c=document.getElementById("game");
const ctx=c.getContext("2d");
const size=32,cols=15,rows=10;
let px=1,py=1,score=0,won=false;
let gems=[[5,1],[10,2],[3,6],[8,7],[13,8]];
const rocks=[[3,1],[3,2],[3,3],[6,3],[7,3],[8,3],
[11,4],[11,5],[5,7],[6,7],[7,7]];
const chest=[13,8];

function draw(){
 ctx.clearRect(0,0,480,320);
 for(let y=0;y<rows;y++){
  for(let x=0;x<cols;x++){
   ctx.fillStyle=(x+y)%2?"#367944":"#2d6939";
   ctx.fillRect(x*size,y*size,size,size);
   if(rocks.some(r=>r[0]===x&&r[1]===y)){
    ctx.fillStyle="#66705a";
    ctx.fillRect(x*size+3,y*size+3,26,26);
    ctx.font="20px Arial";
    ctx.fillText("🪨",x*size+5,y*size+23);
   }
  }
 }
 gems.forEach(g=>{
  if(!g[2]){
   ctx.font="22px Arial";
   ctx.fillText("💎",g[0]*size+5,g[1]*size+25);
  }
 });
 ctx.font="25px Arial";
 ctx.fillText(score===5?"🎁":"🔒",chest[0]*size+3,chest[1]*size+25);
 ctx.fillText("🧑",px*size+4,py*size+25);
 if(won){
  ctx.fillStyle="rgba(0,0,0,.7)";
  ctx.fillRect(0,0,480,320);
  ctx.fillStyle="#ffe17d";
  ctx.font="bold 30px Arial";
  ctx.textAlign="center";
  ctx.fillText("YOU WIN!",240,155);
  ctx.font="18px Arial";
  ctx.fillText("Treasure Found!",240,190);
  ctx.textAlign="left";
 }
}
function move(dx,dy){
 if(won)return;
 let nx=px+dx,ny=py+dy;
 if(nx<0||ny<0||nx>=cols||ny>=rows)return;
 if(rocks.some(r=>r[0]===nx&&r[1]===ny))return;
 px=nx;py=ny;
 gems.forEach(g=>{
  if(!g[2]&&g[0]===px&&g[1]===py){
   g[2]=true;score++;
   document.getElementById("score").textContent=score;
   document.getElementById("msg").textContent="💎 Gem கிடைத்தது!";
  }
 });
 if(px===chest[0]&&py===chest[1]){
  if(score===5){
   won=true;
   document.getElementById("msg").textContent="🏆 வெற்றி! புதையல் கிடைத்தது!";
  }else{
   document.getElementById("msg").textContent="இன்னும் "+(5-score)+" Gems தேவை!";
  }
 }
 draw();
}
function restart(){
 px=1;py=1;score=0;won=false;
 gems=[[5,1],[10,2],[3,6],[8,7],[13,8]];
 document.getElementById("score").textContent=0;
 document.getElementById("msg").textContent="5 Gems சேகரி!";
 draw();
}
document.addEventListener("keydown",e=>{
 const keys={
 ArrowUp:[0,-1],ArrowDown:[0,1],
 ArrowLeft:[-1,0],ArrowRight:[1,0],
 w:[0,-1],s:[0,1],a:[-1,0],d:[1,0]
 };
 if(keys[e.key]){
 e.preventDefault();
 move(...keys[e.key]);
 }
});
draw();
</script>
</body>
</html>
